{
  "name": "rightstrack",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered civic and legal case tracker for RTI and Consumer complaints",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed_demo_cases.js",
    "ingest": "node knowledge-base/scripts/ingest_knowledge.js",
    "test:member3": "node scripts/member3_smoke.js",
    "test:corpus": "node scripts/corpus_check.js",
    "db:init": "node scripts/db-init.js init",
    "db:verify": "node scripts/db-init.js verify",
    "ingest:stats": "node --experimental-modules scripts/ingest.js stats",
    "ingest:test-search": "node --experimental-modules scripts/ingest.js test-search",
    "ingest:clear": "node --experimental-modules scripts/ingest.js clear --confirm",
    "setup": "npm install && npm run db:init && npm run ingest"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.43.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "groq-sdk": "^0.4.0",
    "langchain": "^0.1.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "uuid": "^14.0.2",
    "voyageai": "^0.4.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
